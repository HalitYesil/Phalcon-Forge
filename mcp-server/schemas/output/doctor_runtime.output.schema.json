{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": { "type": "string" },
    "scenario": { "type": "string" },
    "status": { "type": "string", "enum": ["ok", "warn", "fail"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["ok", "warn", "fail"] },
          "message": { "type": "string" }
        },
        "required": ["name", "status"],
        "additionalProperties": false
      }
    }
  },
  "required": ["target", "scenario", "status", "checks"],
  "additionalProperties": false
}
